# Base URL of your Clinia workspace.
CLINIA_CONTEXT_ENGINE_API_URL=https://<workspace-id>.w.clinia.cloud

# OAuth2 client credentials for that workspace. Create them in the Clinia
# Console with Read & Write access — the studio ingests data and creates
# patients, so Read-only credentials fail on those actions. The secret is shown
# once at creation and cannot be retrieved afterwards.
CLINIA_CONTEXT_ENGINE_OAUTH_CLIENT_ID=<your-client-id>
CLINIA_CONTEXT_ENGINE_OAUTH_CLIENT_SECRET=<your-client-secret>

# Used by the chat assistant. Needs access to claude-opus-4-8.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Local SQLite file backing the studio's chat history (sidebar + reopen).
# Optional; defaults to ./.data/studio-chats.db when unset.
STUDIO_CHAT_DB_PATH=./.data/studio-chats.db
